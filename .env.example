# =====================================================================
# StoolCheck AI - environment configuration TEMPLATE
#
# Copy this file to `.env` (project root) and fill in real values:
#     cp .env.example .env
# Real environment variables always override `.env` values.
# `.env` is git-ignored - NEVER commit real secrets.
# =====================================================================

# --- Application environment -------------------------------------------------
# development | production
# production enables: no auto-reload, /docs hidden (unless ENABLE_DOCS=true),
# and a hard requirement for a strong SECRET_KEY.
ENVIRONMENT=development

# --- MySQL database (production) --------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=stoolcheck_db
# Optional: full SQLAlchemy URL. When set, it OVERRIDES the MYSQL_* values above.
# STOOLCHECK_DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/stoolcheck_db

# --- JWT authentication ------------------------------------------------------
# REQUIRED in production - must be >= 32 random characters (64+ recommended).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
# Legacy alias still accepted: STOOLCHECK_SECRET_KEY
# Token lifetime in minutes (default 720 = 12 hours)
JWT_EXPIRE_MINUTES=720

# --- HTTP server -------------------------------------------------------------
# Used by `python main.py` (dev). Production binds via gunicorn/start.sh.
HOST=127.0.0.1
PORT=8000
# Enable auto-reload for `python main.py` (ignored in production - never reloads)
RELOAD=true

# --- CORS --------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
# REQUIRED in production for cross-origin frontends; a same-origin deployment
# (frontend served by this app at "/") needs no CORS at all.
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- API docs ----------------------------------------------------------------
# Expose /docs, /redoc and /openapi.json. Defaults: yes in development, no in production.
ENABLE_DOCS=false
